# Google reCAPTCHA v3 Configuration
# Get your keys from: https://www.google.com/recaptcha/admin/create

# Site key (public) - Used in frontend
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# Secret key (private) - Used in backend/server-side verification
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here

# Email Notification Configuration
NOTIFICATION_API_URL=http://ec2-44-233-162-24.us-west-2.compute.amazonaws.com:8889/api/notifications/send
NOTIFICATION_CLIENT_ID=your_client_id_here
CONTACT_EMAIL_RECIPIENT=info@arianedevs.com
CONTACT_EMAIL_SUBJECT=Solicitud de contacto
