---
// Define props from Astro
const {
  text = "Descubre más",
  ariaLabel = "Desplázate hacia abajo para ver más contenido",
} = Astro.props;

// Define TypeScript interface for props
interface Props {
  text?: string;
  ariaLabel?: string;
}
---

<!-- Scroll Indicator Component -->
<div class="flex animate-bounce flex-col items-center justify-center py-8">
  <!-- Text indicator -->
  <p class="mb-2 text-sm font-medium text-neutral-600 dark:text-neutral-400">
    {text}
  </p>

  <!-- Animated arrow icon -->
  <button
    onclick="window.scrollTo({ top: window.innerHeight, behavior: 'smooth' })"
    aria-label={ariaLabel}
    class="group flex flex-col items-center justify-center rounded-full p-2 transition-all duration-300 hover:bg-neutral-100 focus:ring-2 focus:ring-yellow-500 focus:ring-offset-2 focus:outline-none dark:hover:bg-neutral-800 dark:focus:ring-offset-neutral-900"
  >
    <!-- Double chevron down for better visual impact -->
    <svg
      class="h-6 w-6 transform text-neutral-500 transition-colors duration-300 group-hover:translate-y-1 group-hover:text-yellow-500 dark:text-neutral-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </button>
</div>

<!-- CSS Animation styles -->
<style>
  @keyframes bounce-soft {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-bounce {
    animation: bounce-soft 2s infinite;
  }

  /* Alternative pulse animation */
  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.7;
    }
  }

  .animate-pulse-glow {
    animation: pulse-glow 2s infinite;
  }
</style>
